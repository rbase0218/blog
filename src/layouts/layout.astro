---
import { SITE } from '@constants'
import SkipNavLink from '@components/a11y/skip-nav-link.astro'
import Header from '@components/header.astro'
import Footer from '@components/footer.astro'
import ThemeProvider from '@components/theme-provider.astro'
import '@styles/global.css'
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preload" href="/fonts/PretendardVariable.woff2" as="font" type="font/woff2" crossorigin />
		<ThemeProvider />
		<slot name="seo" />
	</head>
	<body class="min-h-screen bg-bg text-text">
		<SkipNavLink />
		<div class="container flex w-full flex-col gap-8 py-8 sm:gap-16">
			<Header />
			<slot />
			<Footer />
		</div>
	</body>
</html>

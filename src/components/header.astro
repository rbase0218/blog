---
import { HEADER, SITE } from '@constants'
import Link from './link.astro'
import Search from './search.astro'
import ThemeToggle from './theme-toggle.astro'

interface Props {
	activeCategory?: 'blog' | 'note'
}

const { activeCategory } = Astro.props
const { pathname } = Astro.url
---

<header class="flex flex-wrap items-center gap-x-6 gap-y-4 border-b border-divider pb-4 sm:flex-nowrap sm:gap-8">
	<a class="shrink-0 font-normal text-[24px] text-primary" href="/" aria-label={`${SITE.title} - 홈으로 이동`}
		>{SITE.title}</a
	>
	<nav aria-label="주 메뉴" class="flex shrink-0 gap-4 text-base md:text-xl">
		{
			HEADER.internal.map((link) => (
				<Link
					href={link.url}
					class="category-link"
					aria-current={pathname === link.url || activeCategory === link.title ? 'page' : undefined}
				>
					{link.title}
				</Link>
			))
		}
	</nav>
	<div
		class="ml-auto flex w-full min-w-0 items-center justify-end gap-1 sm:w-auto sm:flex-1 sm:gap-4 text-base md:text-xl"
	>
		<Search />
		<span aria-hidden="true" class="h-5 w-px shrink-0 bg-divider"></span>
		<ThemeToggle />
	</div>
</header>

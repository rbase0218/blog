---

{/* This is intentionally inlined to avoid FOUC. */}
<script is:inline>
	/* eslint-disable style/brace-style -- Astro formats inline scripts with same-line catch blocks. */
	window.AtmbThemeProvider = (() => {
		const media = window.matchMedia('(prefers-color-scheme: dark)')
		let preference
		try {
			preference = localStorage.getItem('atmb-theme')
		} catch {
			// Keep theme switching available when browser storage is blocked.
		}
		if (preference !== 'light' && preference !== 'dark') {
			preference = null
		}

		const updateToggles = () => {
			const dark = document.documentElement.dataset.theme === 'dark'
			document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
				button.setAttribute('aria-pressed', String(dark))
			})
		}
		const applyTheme = () => {
			document.documentElement.dataset.theme = preference || (media.matches ? 'dark' : 'light')
			updateToggles()
		}
		applyTheme()
		media.addEventListener('change', () => {
			if (!preference) {
				applyTheme()
			}
		})

		return {
			updateToggles,
			toggle() {
				preference = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
				applyTheme()
				try {
					localStorage.setItem('atmb-theme', preference)
				} catch {
					// Keep theme switching available when browser storage is blocked.
				}
			},
		}
	})()
</script>

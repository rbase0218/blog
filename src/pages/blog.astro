---
import Layout from '@layouts/layout.astro'
import Seo from '@components/seo.astro'
import { getCollection } from 'astro:content'
import SkipNavContent from '@components/a11y/skip-nav-content.astro'
import { defaultDateFormat, sortAsc } from '@utils'
import Spacer from '@components/spacer.astro'
import Link from '@components/link.astro'
import TagLinks from '@components/tag-links.astro'
import Prose from '@components/prose.astro'

const posts = sortAsc(await getCollection('blog'))
---

<Layout>
	<Seo slot="seo" title="blog" />
	<SkipNavContent>
		<Prose>
			<h1 class="mb-8!">blog</h1>
		</Prose>
		<div class="flex gap-10 flex-col">
			{
				posts.map(({ data: post }) => (
					<div>
						<Link variant="highlight" class="font-medium" href={`/${post.slug}/`}>
							{post.title}
						</Link>
						<Spacer axis="vertical" size={2} />
						<div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-faded">
							<span>{defaultDateFormat(post.date)}</span>
							<TagLinks tags={post.tags} />
						</div>
						<Spacer axis="vertical" size={4} />
						<div class="text-subtle text-md md:text-lg">{post.description}</div>
					</div>
				))
			}
		</div>
	</SkipNavContent>
</Layout>

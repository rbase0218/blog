---
import SkipNavContent from '@components/a11y/skip-nav-content.astro'
import Link from '@components/link.astro'
import TagLinks from '@components/tag-links.astro'
import Seo from '@components/seo.astro'
import Spacer from '@components/spacer.astro'
import { FRONTMATTER_TAGS } from '@constants'
import Layout from '@layouts/layout.astro'
import { defaultDateFormat, getPostsByTag } from '@utils'
import { getCollection } from 'astro:content'

/**
 * 1. Generate static pages for all tags.
 * 2. Each tag page will have a list of entries associated with that tag.
 */
export async function getStaticPaths() {
	const entries = [...(await getCollection('blog')), ...(await getCollection('note'))]

	let result = []

	for (const [tagName, tagSlug] of FRONTMATTER_TAGS) {
		const postsWithTag = getPostsByTag(entries, tagName)

		result.push({
			params: {
				tag: tagSlug,
			},
			props: {
				tagName,
				tagSlug,
				postsWithTag,
			},
		})
	}

	return result
}

const { tagName, postsWithTag } = Astro.props
---

<Layout>
	<Seo slot="seo" title={`태그: ${tagName}`} />
	<SkipNavContent>
		<div class="border-b border-divider pb-4 flex justify-between items-center">
			<h1 class="font-medium text-[20px] text-highlight">태그: {tagName}</h1>
			<div><Link href="/tags/">전체 태그 보기</Link></div>
		</div>
		<Spacer axis="vertical" size={8} />
		<div class="flex gap-10 flex-col">
			{
				postsWithTag.map(({ data: post }) => (
					<div>
						<Link variant="highlight" href={`/${post.slug}/`}>
							{post.title}
						</Link>
						<Spacer axis="vertical" size={2} />
						<div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-faded">
							<span>{defaultDateFormat(post.date)}</span>
							<TagLinks tags={post.tags} />
						</div>
					</div>
				))
			}
		</div>
	</SkipNavContent>
</Layout>
